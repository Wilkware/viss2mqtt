# viss2mqtt – Cronjobs für den Vito-Rechner
#
# deploy.sh installiert diese Datei als /etc/cron.d/viss2mqtt und ersetzt dabei
# @USER@ durch den Benutzer, der deploy.sh ausführt. Nicht von Hand in
# /etc/cron.d ändern – eigene Fassung als /opt/viss2mqtt/local/viss2mqtt.cron
# ablegen und ./deploy.sh aufrufen.
#
# Beide Jobs teilen sich ein Lock, damit nie zwei vclient-Läufe gleichzeitig
# auf vcontrold/Optolink zugreifen. Der volle Lauf belegt vcontrold ca. 75 s,
# ein Schnelllauf wartet dann bis zu 30 s und läuft direkt danach.
# run.sh wählt .lst/.tpl aus (local/ vor Standard) und ruft vclient auf.

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# Schnelllauf: jede Minute (5 Befehle, ca. 10 s)
* * * * * @USER@ flock -w 30 /opt/viss2mqtt/vito.lock /opt/viss2mqtt/run.sh viss2mqtt-fast > /opt/viss2mqtt/viss2mqtt-fast.log 2>&1

# Voller Lauf: alle 5 Minuten (34 Befehle, ca. 75 s)
*/5 * * * * @USER@ flock -w 60 /opt/viss2mqtt/vito.lock /opt/viss2mqtt/run.sh viss2mqtt > /opt/viss2mqtt/viss2mqtt.log 2>&1
