# Crontab von root (sudo crontab -e) auf dem Rechner mit vcontrold.
# Beide Jobs teilen sich ein Lock, damit nie zwei vclient-Laeufe gleichzeitig
# auf vcontrold/Optolink zugreifen. Der volle Lauf belegt vcontrold ca. 75 s,
# ein Schnelllauf wartet dann bis zu 30 s und laeuft direkt danach.
# vclient immer mit absolutem Pfad: der Cron-PATH kennt /usr/local/bin nicht
# ("flock: failed to execute vclient").

# Schnelllauf: jede Minute (5 Befehle, ca. 10 s)
* * * * * flock -w 30 /tmp/vito.lock /usr/local/bin/vclient -v -f /opt/viss2mqtt/viss2mqtt-fast.lst -t /opt/viss2mqtt/viss2mqtt-fast.tpl -x /opt/viss2mqtt/viss2mqtt-fast.sh > /opt/viss2mqtt/viss2mqtt-fast.log 2>&1

# Voller Lauf: alle 5 Minuten (34 Befehle, ca. 75 s)
*/5 * * * * flock -w 60 /tmp/vito.lock /usr/local/bin/vclient -v -f /opt/viss2mqtt/viss2mqtt.lst -t /opt/viss2mqtt/viss2mqtt.tpl -x /opt/viss2mqtt/viss2mqtt.sh > /opt/viss2mqtt/viss2mqtt.log 2>&1
